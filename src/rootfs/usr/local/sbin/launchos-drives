#!/usr/bin/python3
"""Opens (mounts) drives at /media/player/<name> so Files, Wine and other apps can use them.

  launchos-drives           USB and other removable drives (run when one is plugged in)
  launchos-drives --udev    the same, after a moment so a drive's partitions all show up
  launchos-drives DEVICE    one partition, also one inside the PC (opened from Files)
"""
import os, sys, time
sys.path.insert(0, "/usr/local/lib/launchos")
import disks as D


def walk(nodes):
    for n in nodes:
        yield n
        yield from walk(n.get("children") or [])


def removable_pass(sysdisks, skip):
    """Mount every removable drive that isn't open yet. Returns how many were opened."""
    opened = 0
    for disk in D.lsblk():
        if disk.get("type") != "disk" or disk.get("name") in sysdisks or not D.DISK.fullmatch(disk.get("name", "")):
            continue
        if not (disk.get("rm") or disk.get("tran") == "usb"):
            continue
        kids = [c for c in walk(disk.get("children") or []) if c.get("type") == "part"]
        nodes = kids or [disk]
        for n in nodes:
            if not D.usable(n, sysdisks) or any(m for m in (n.get("mountpoints") or []) if m) or D.in_use([n])[1]:
                continue
            if len(nodes) > 1 and int(n.get("size") or 0) < 64 << 20:   # tiny helper partitions (boot loaders on USB sticks)
                continue
            if n.get("uuid") in skip:   # ejected: stays closed until it's plugged in again
                continue
            if D.mount(n["name"], n["fstype"], n.get("label") or "", n.get("uuid") or ""):
                opened += 1
    return opened


def open_one(dev, sysdisks):
    D.status("drive", "Opening the drive", 20)
    if not (D.PART.fullmatch(dev) or D.DISK.fullmatch(dev)) or not os.path.exists(dev):
        D.status("drive", "", 100, True, "That drive isn’t there any more.")
        return
    info = (D.lsblk(dev) or [{}])[0]
    if D.ancestors(dev) & sysdisks:
        D.status("drive", "", 100, True, "That drive is used by LaunchOS itself.")
        return
    points, held = D.in_use([info])
    if any(p.startswith(D.MEDIA + "/") for p in points):
        D.status("drive", "Open", 100, True)
        return
    if points or held or not D.usable(info, sysdisks):
        D.status("drive", "", 100, True, "LaunchOS can’t open this drive. Its format isn’t supported, or it belongs to another system.")
        return
    skip = D.ejected()
    if info.get("uuid") in skip:   # opened again on purpose
        D.set_ejected(skip - {info.get("uuid")})
    if D.mount(dev, info["fstype"], info.get("label") or "", info.get("uuid") or ""):
        D.status("drive", "Open", 100, True)
    else:
        D.status("drive", "", 100, True, "Couldn’t open the drive. It may need checking in Windows first.")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--udev":
        time.sleep(1)
    single = arg.startswith("/dev/")
    # opening one drive waits its turn; the automatic pass just steps aside while a
    # format or install is running (that job opens the drive itself when it's done)
    fd = D.lock(wait=single)
    if fd is None:
        return
    try:
        D.cleanup()
        sysdisks = D.system_disks()
        # forget ejected drives that were unplugged
        present = {n.get("uuid") for n in walk(D.lsblk())}
        skip = D.ejected()
        if skip - present:
            skip &= present
            D.set_ejected(skip)
        if single:
            open_one(arg, sysdisks)
        else:
            for _ in range(3):   # another drive may have come in meanwhile
                if not removable_pass(sysdisks, skip):
                    break
    finally:
        os.close(fd)


if __name__ == "__main__":
    main()
