#!/bin/bash
# Installs an app from Flathub. Only apps on this list are allowed.
. /usr/local/sbin/launchos-status
case "$1" in
  org.vinegarhq.Sober) name="Roblox (Sober)"; key=roblox ;;
  io.freetubeapp.FreeTube) name="FreeTube"; key=freetube ;;
  *) exit 1 ;;
esac
status "get-$key" "Connecting to Flathub" 0 false ""
if ! flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1; then
  status "get-$key" "" 0 true "Couldn't reach Flathub. Check your internet connection and try again."; exit 1
fi
status "get-$key" "Downloading $name" 1 false ""
last=-1
flatpak install -y --noninteractive flathub "$1" 2>&1 | tr '\r' '\n' | while read -r line; do
  p=$(echo "$line" | grep -oE '[0-9]{1,3}%' | tail -1 | tr -d '%')
  [ -n "$p" ] && [ "$p" != "$last" ] && { last=$p; status "get-$key" "Downloading $name" "$p" false ""; }
done
if flatpak info "$1" >/dev/null 2>&1; then
  status "get-$key" "Installed" 100 true ""
else
  status "get-$key" "" 0 true "The download didn't finish. Check your internet connection and try again."; exit 1
fi
