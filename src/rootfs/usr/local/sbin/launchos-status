# Shared by LaunchOS job scripts: writes progress the launcher shows.
# status FILE STEP PERCENT DONE ERROR   (files live in a root-owned folder)
status() {
  mkdir -p /run/launchos-status; chmod 755 /run/launchos-status
  python3 - "$@" <<'PY'
import json, os, sys
name, step, pct, done, err = sys.argv[1:6]
path = os.path.join("/run/launchos-status", name + ".json")
with open(path + ".tmp", "w") as f:
    json.dump({"step": step, "percent": int(float(pct)), "done": done == "true", "error": err}, f)
os.chmod(path + ".tmp", 0o644)
os.replace(path + ".tmp", path)
PY
}
