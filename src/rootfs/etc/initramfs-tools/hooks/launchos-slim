#!/bin/sh
# LaunchOS: a small start-up image (initramfs) loads and unpacks in a fraction of the time.
# The big AMD and NVIDIA graphics drivers and their firmware (about 140 MB) stay out of it:
# they load from the system a few seconds later, and the boot animation uses the screen the
# PC's firmware set up until then (GRUB sets one on BIOS PCs too). Intel graphics, virtual
# machine graphics and everything needed to find the disc or USB stick stay in.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

[ -n "$DESTDIR" ] && [ -d "$DESTDIR" ] || exit 0
M="$DESTDIR/usr/lib/modules/$version/kernel/drivers/gpu/drm"
for d in "$M/amd" "$M/nouveau" "$M/radeon" \
         "$DESTDIR/usr/lib/firmware/amdgpu" "$DESTDIR/usr/lib/firmware/nvidia" "$DESTDIR/usr/lib/firmware/radeon" \
         "$DESTDIR/lib/firmware/amdgpu" "$DESTDIR/lib/firmware/nvidia" "$DESTDIR/lib/firmware/radeon"; do
  [ -e "$d" ] && rm -rf "$d"
done
exit 0
