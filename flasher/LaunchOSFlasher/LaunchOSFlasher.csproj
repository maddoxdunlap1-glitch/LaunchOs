<Project Sdk="Microsoft.NET.Sdk">
  <!-- LaunchOS Flasher: one small .exe for Windows 10 and 11 (.NET Framework 4.8 comes with Windows) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LaunchOS-Flasher</AssemblyName>
    <RootNamespace>LaunchOSFlasher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0</Version>
    <Product>LaunchOS Flasher</Product>
    <Description>Writes LaunchOS to a USB drive</Description>
    <Copyright>LaunchOS</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
